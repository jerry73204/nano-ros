#!/usr/bin/env bash
#
# Refuse to push (a) a duplicate issue id, (b) a submodule pin that moved
# backward, or (c) anything the fast gate tier rejects.
#
# `scripts/reserve-issue-id.sh` stops two sessions from CHOOSING the same id.
# This stops a duplicate from LANDING when the reservation was skipped, or when
# the id was chosen by hand before the tool existed. Both are needed: the first
# prevents wasted work, the second is the guarantee.
#
# Why here and not only in `check-fast`: the gate has always been able to catch
# this, and repeatedly did not, because of WHEN it runs. A session files 0372,
# runs `check-fast` (green — no duplicate exists in ITS tree), rebases onto a
# main that now contains someone else's 0372, and pushes. The rebase is the
# moment the duplicate becomes visible, and nothing re-checked between the
# rebase and the push. `pre-push` is exactly that gap.
#
# Cheap by construction: reads filenames, no build, no network.
#
# Install: `just setup-hooks` (or `git config core.hooksPath .githooks`).
# Bypass for a genuine emergency: `git push --no-verify`.

set -euo pipefail

# A hook can inherit a repository-local git environment (GIT_DIR, and with it
# GIT_WORK_TREE / GIT_INDEX_FILE / GIT_CONFIG / ...), and those override BOTH a
# path argument and `git -C`. Every command this hook invokes -- the gate tier,
# the selftests that build throwaway repositories -- would then be silently
# redirected at the repo being pushed. Observed: `git init <tmp>` rewrote this
# repo's config with core.bare=true, which broke `rev-parse --show-toplevel`
# below for every later push, and `update-index --add --cacheinfo 160000,...`
# staged a bogus submodule pin into this repo's index -- from the hook whose job
# is to refuse bogus submodule pins (issue 0986).
#
# Everything below resolves from the working directory, which is where git puts
# a hook, so clear them here. Measured: an ordinary `git push` sets only
# GIT_PREFIX, but a push from a LINKED WORKTREE sets GIT_DIR -- which is the
# normal shape for the parallel agent sessions this repo runs. That is also why
# running this hook by hand never reproduced the failure.
#
# The variable list is git's own (`git rev-parse --local-env-vars`) and has ONE
# spelling, shared with the scripts below; `check-hook-repo-side-effects` proves
# the property rather than the spelling.
# shellcheck source=scripts/lib/git-hook-env.sh
. "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/git-hook-env.sh"
nros_clear_inherited_git_env

repo_root="$(git rev-parse --show-toplevel)"
check="$repo_root/scripts/ci/issue-ids-check.sh"

[ -x "$check" ] || exit 0

# Guard BRANCH pushes only.
#
# git feeds us `<local-ref> <local-sha> <remote-ref> <remote-sha>` per ref. An
# earlier draft ignored that and checked every push, which deadlocked: while a
# duplicate existed, `reserve-issue-id.sh` could not push its reservation ref
# either — so the tool that resolves a collision was blocked BY the collision.
# Found by dogfooding the reservation immediately after writing the hook.
#
# Non-branch pushes (`refs/issue-ids/*`, tags, notes) carry no issue files and
# have nothing to corrupt.
# git feeds the ref lines on stdin ONCE. Both checks below need them, so spool
# them to a temp file rather than letting the first consumer eat them (an
# earlier draft did, and the pin check silently never ran).
hook_stdin="$(mktemp)"
trap 'rm -f "$hook_stdin"' EXIT
cat > "$hook_stdin"

guard=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    case "$remote_ref" in
        refs/heads/*) guard=1 ;;
    esac
done < "$hook_stdin"

# NO ref lines means git is pushing nothing — it already rejected the update
# locally (e.g. a non-fast-forward reservation re-claim, which is the CAS
# working). Reporting an issue-id failure there would blame the wrong thing:
# an earlier draft did exactly that, and the "duplicate issue ids" error came
# out of a push that had nothing to do with issue files.
#
# Verified against git's actual behaviour rather than assumed — it feeds
# `<local-ref> <local-sha> <remote-ref> <remote-sha>` for a ref it intends to
# push, and feeds NOTHING when it does not.
[ "$guard" -eq 0 ] && exit 0

if ! out="$("$check" 2>&1)"; then
    printf '%s\n' "$out" >&2
    echo "" >&2
    echo "pre-push: REFUSING to push — the issue-id namespace would be corrupted." >&2
    echo "" >&2
    echo "  If this appeared right after a rebase, another session filed the same" >&2
    echo "  id first. Renumber YOUR filing (the later one), update its \`id:\`" >&2
    echo "  frontmatter and every reference, then push again." >&2
    echo "" >&2
    echo "  Reserve ids atomically to avoid this entirely:" >&2
    echo "      just issue-new <slug>" >&2
    exit 1
fi

# A submodule pin may only move FORWARD (fast-forward to a descendant).
#
# Here for the same reason the issue-id check is: WHEN it runs. A rewind is
# usually not authored, it is INHERITED — you rebase onto a main whose pin went
# backward, and your push carries that rewind along with your own work. Nothing
# between the rebase and the push looks at it, and a `-Subproject commit` line
# is two hex strings that no reviewer can order by eye.
#
# The baseline is the remote's ACTUAL sha (git hands it to us per ref), not
# `origin/main`, which can be stale by exactly the window that matters.
pins="$repo_root/scripts/ci/submodule-pins-check.sh"
if [ -x "$pins" ]; then
    while IFS= read -r line; do
        set -- $line
        remote_ref="${3:-}"
        remote_sha="${4:-}"
        local_sha="${2:-}"
        case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
        # All-zero remote sha = a new branch; nothing on the remote to regress.
        case "$remote_sha" in *[!0]*) ;; *) continue ;; esac
        [ -n "$local_sha" ] || continue
        if ! out="$("$pins" "$remote_sha" "$local_sha" 2>&1)"; then
            printf '%s\n' "$out" >&2
            echo "" >&2
            echo "pre-push: REFUSING to push — a submodule pin would move backward." >&2
            echo "" >&2
            echo "  If this appeared right after a rebase, the rewind is probably not" >&2
            echo "  yours: someone else's commit moved the pin back and you inherited" >&2
            echo "  it. Restore the newer commit as shown above and push again." >&2
            exit 1
        fi
    done < "$hook_stdin"
fi

# A submodule pin must name a commit the REMOTE can serve.
#
# The push is the only moment this can still be fixed cheaply. Afterwards the
# superproject commit is published naming a commit nobody else can obtain, and
# the fix is a rewrite or a revert — a pin cannot point at nothing. AGENTS.md
# has required "push the submodule commit FIRST" all along; this is the first
# thing that checks.
#
# Scoped to pins this push MOVES, so the cost is proportional to what is being
# published rather than to the number of submodules. An unchanged pin was
# already reachable or the tree would not build today.
reach="$repo_root/scripts/ci/submodule-commits-reachable.sh"
if [ -x "$reach" ]; then
    while IFS= read -r line; do
        set -- $line
        remote_ref="${3:-}"
        remote_sha="${4:-}"
        local_sha="${2:-}"
        case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
        [ -n "$local_sha" ] || continue
        # A NEW branch (all-zero remote sha) has no baseline to diff against,
        # so check every pin rather than skipping — a new branch is exactly
        # where a fresh, unpushed submodule commit tends to arrive.
        case "$remote_sha" in
            *[!0]*) out="$("$reach" --changed "$remote_sha" 2>&1)" ;;
            *)
                # A new branch has no remote baseline, but it almost always
                # DESCENDS from one: anything already on the upstream default
                # branch is published by definition, or that branch would not
                # build. Baselining against it keeps the intent above — a fresh
                # unpushed submodule commit still gets checked, because it is
                # exactly what a new branch ADDS — without re-verifying every
                # pin the tree already carries.
                #
                # That mattered: a branch whose commits touch NO submodule was
                # refused because an unrelated, uninitialised pin could not be
                # probed, and the push had no honest way through.
                base=""
                if upstream="$(git rev-parse --verify --quiet refs/remotes/origin/HEAD 2>/dev/null)" \
                   || upstream="$(git rev-parse --verify --quiet refs/remotes/origin/main 2>/dev/null)"; then
                    # Only when the push actually descends from it; otherwise
                    # the diff would be meaningless and every pin must be read.
                    if git merge-base --is-ancestor "$upstream" "$local_sha" 2>/dev/null; then
                        base="$upstream"
                    fi
                fi
                if [ -n "$base" ]; then
                    out="$("$reach" --changed "$base" 2>&1)"
                else
                    out="$("$reach" 2>&1)"
                fi
                ;;
        esac
        rc=$?
        # 2 = could not ask the remotes. Say so and let the push through: a
        # push is already a network operation, so if the network were truly
        # gone this would not be running — and refusing on an unanswerable
        # question is worse than reporting it.
        if [ "$rc" -eq 2 ]; then
            echo "pre-push: submodule reachability NOT verified (no network)." >&2
            continue
        fi
        if [ "$rc" -ne 0 ]; then
            printf '%s\n' "$out" >&2
            echo "" >&2
            echo "pre-push: REFUSING to push — a submodule pin names a commit no clone can get." >&2
            echo "" >&2
            echo "  Push the submodule branch first, then push this. Order matters:" >&2
            echo "  the superproject may only pin what is already published." >&2
            exit 1
        fi
    done < "$hook_stdin"
fi

# (c) The fast gate tier — issue 0840.
#
# On 2026-08-27 four independent reds landed on main in one day, across two
# commits, and EVERY one was already covered by an existing gate: a lib test
# target that did not compile (69 tests dead), a file committed unformatted, a
# hardcoded cargo profile directory, and a hand-rolled ROS env export. Nothing
# between the edit and the push had asked whether any tier ran, so none of them
# did.
#
# That is a different shape from the two checks above. Those catch defects that
# become true AT REBASE, invisible to anything the author ran earlier. These
# four were true in the author's own tree the whole time and simply went
# unexamined — so what catches them is not a smarter re-check, it is running the
# gates once at the last moment where refusing is still cheap.
#
# WHY `check-fast` AND NOT `check`: `check` also compiles (`check-build`), and a
# pre-push hook costing minutes gets `--no-verify`'d within a week — after which
# its presence implies a guarantee nobody has. That is CLAUDE.md's own lesson
# about the pre-phase-318 `just ci`: an instruction nobody can afford gets
# followed selectively, which is worse than a smaller one followed honestly.
# `check-fast` is buildless and source-free, and covers three of the four reds.
# The fourth needs the compile tier and is deliberately NOT covered here; the
# hook says so rather than let its silence imply completeness.
#
# The whole recipe, not a curated subset: a gate list spelled out here would
# drift from `check-fast` silently, which is the #282->#326 shape this repo
# keeps paying for.
if [ "${NROS_SKIP_PREPUSH_CHECKS:-}" = "1" ]; then
    echo "pre-push: fast gates SKIPPED (NROS_SKIP_PREPUSH_CHECKS=1)." >&2
elif ! command -v just >/dev/null 2>&1; then
    # Never fail a push because the runner is missing — that is not evidence of
    # a defect, and a hook that blocks on its own tooling gets removed.
    echo "pre-push: \`just\` not on PATH — fast gates NOT run." >&2
else
    echo "pre-push: running \`just check fast\` (issue 0840)." >&2
    echo "          Bypass: git push --no-verify, or NROS_SKIP_PREPUSH_CHECKS=1" >&2
    if ! (cd "$repo_root" && just check fast); then
        echo "" >&2
        echo "pre-push: REFUSING to push — the fast gate tier is red." >&2
        echo "" >&2
        echo "  Fix the failure above and push again. If it is not yours, it came" >&2
        echo "  in on the rebase: say so in the commit that fixes it." >&2
        echo "" >&2
        echo "  Emergency bypass:  git push --no-verify" >&2
        exit 1
    fi
    echo "pre-push: fast gates green. NOTE this is the FAST tier only — it does" >&2
    echo "          not compile, so a broken test target still gets through." >&2
    echo "          Run the tier your change earns (RFC-0061): just ci / ci-matrix." >&2
fi

exit 0
