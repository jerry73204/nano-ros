    bool "C API (nros-c)"
    help
      Build and link the nros C API library (libnros_c.a).
      Uses nros_* functions from nros/init.h, nros/node.h, etc.

config NROS_CPP_API
    bool "C++ API (nros-cpp)"
    select CPP
    help
      Build and link the nros C++ API library (libnros_cpp.a).
      Uses nros::init(), nros::Node, nros::Publisher<M>, etc.
      Requires C++ support (automatically selected).

config NROS_RUST_API
    bool "Rust API (nros crate)"
    depends on RUST
    help
      Use the nros Rust crate via rust_cargo_application().
      Kconfig values are bridged to Cargo env vars automatically.

endchoice

# =============================================================================
# RMW Backend Selection
# =============================================================================

choice NROS_RMW_BACKEND
    prompt "RMW backend"
    default NROS_RMW_ZENOH

config NROS_RMW_ZENOH
    bool "zenoh-pico"
    help
      Use zenoh-pico as the RMW transport backend.
      Connects to a zenoh router for ROS 2 interop via rmw_zenoh.

config NROS_RMW_XRCE
    bool "XRCE-DDS"
    depends on NET_SOCKETS
    help
      Use Micro-XRCE-DDS as the RMW transport backend.
      Connects to a Micro-XRCE-DDS Agent over UDP sockets.

config NROS_RMW_CYCLONEDDS
    bool "Cyclone DDS (nros-rmw-cyclonedds)"
    depends on NET_SOCKETS && POSIX_API && CPP
    # Phase 11W — universal Cyclone-DDS-on-Zephyr runtime requirements
    # (formerly duplicated in every cyclonedds prj-cyclonedds.conf):
    #   THREAD_LOCAL_STORAGE — Cyclone's `ddsrt_thread_local
    #     tsd_thread_state` needs real per-thread `__thread` storage.
    #   THREAD_CUSTOM_DATA — the cyclonedds-zephyr-threads patch uses
    #     k_thread_custom_data in place of pthread TLS for ddsrt cleanup.
    #   DYNAMIC_THREAD(+ALLOC) — Cyclone's worker threads (gc/recv/
    #     lease/tev) are pthread_create'd with no explicit stack attr;
    #     Zephyr needs the dynamic-thread stack pool or pthread_create
    #     returns EINVAL. THREAD_STACK_INFO + THREAD_MONITOR are
    #     DYNAMIC_THREAD's own dependencies.
    # (NET_TCP — the sockwaitset self-pipe needs it, but selecting it
    #  here forms a Kconfig dependency loop through NET_SOCKETS, so it
    #  stays in the example overlay.)
    # Int knobs (pthread pool sizes, malloc arena, stack size), NET_TCP,
    # and the native_sim-only NSOS socket offload stay in the example
    # overlays.
    # `imply` (not `select`): set most of these on by default but
    # respect each symbol's own dependencies (e.g. THREAD_LOCAL_STORAGE
    # needs ARCH_HAS_THREAD_LOCAL_STORAGE) and avoid select dependency
    # loops. THREAD_CUSTOM_DATA has no extra deps and is required at link
    # time by the CycloneDDS Zephyr thread shim, so select it directly.
    imply THREAD_LOCAL_STORAGE
    select THREAD_CUSTOM_DATA
    imply THREAD_STACK_INFO
    imply THREAD_MONITOR
    imply DYNAMIC_THREAD
    imply DYNAMIC_THREAD_ALLOC
    help
      Use Cyclone DDS (pinned to 0.10.5, matches ros-humble-cyclonedds)
      as the RMW transport backend. Wire-compatible with stock
      rmw_cyclonedds_cpp on the ROS 2 Humble peer side.

      Implementation lives at packages/rmw/cyclonedds/nros-rmw-cyclonedds/ as a
      standalone C++ project; the Zephyr module compiles the pinned
      Cyclone DDS submodule plus the nros-rmw-cyclonedds register
      glue into the app library. The register entry point
      (`nros_rmw_cyclonedds_register`) is declared with C linkage
      in `nros_rmw_cyclonedds.h`, so both the C API
      (CONFIG_NROS_C_API=y) and C++ API (CONFIG_NROS_CPP_API=y) can
      call it via the Phase 160.A strong-stub emission.

      Phase 117 — see docs/roadmap/phase-117-cyclonedds-rmw.md.
      Phase 168.X gap 2.B dropped the NROS_CPP_API requirement so
      C-API examples can also pick this backend through
      `prj-cyclonedds.conf` overlays.

endchoice

# =============================================================================
# Wall-clock epoch (issue 0758)
# =============================================================================

config NROS_SNTP_EPOCH
    bool "Acquire a wall-clock epoch over SNTP at boot"
    depends on NETWORKING
    select SNTP
    select DNS_RESOLVER
    help
      Acquire an absolute UNIX epoch once at boot, after the network is up,
      so `nros_platform_epoch_us()` can answer and messages carry stamps a
      peer will accept.

      Without this the platform answers 0, which nano-ros defines as "this
      image has no wall clock" — callers then stamp boot-relative time
      KNOWINGLY rather than publishing a confidently wrong absolute one.
      That is a safe default, not a broken one, and it is why this is opt-in.

      Why you would turn it on: a peer that validates stamps rejects
      boot-relative ones. The case this exists for is an embedded island
      whose control commands Autoware's vehicle_cmd_gate refused as stale,
      so autonomous mode could never actuate.

      One acquisition, no continuous discipline. The reading is converted to
      a fixed offset against the monotonic clock, so later reads cost no
      network traffic and cannot fail; the clock jumps exactly once, when
      the offset is installed.

config NROS_SNTP_SERVER
    string "SNTP server (host or IP)"
    depends on NROS_SNTP_EPOCH
    default "10.0.2.2"
    help
      Server to query at boot. The default is the QEMU/slirp host address,
      which is what an emulated board reaches a host-side time source on —
      the same address the baked zenoh locators use.

      This is a BOARD/DEPLOY fact, not application configuration: it belongs
      to where the image runs, so it rides the same rung as the locator
      rather than a consumer #define.

config NROS_SNTP_TIMEOUT_MS
    int "SNTP timeout (ms)"
    depends on NROS_SNTP_EPOCH
    default 3000
    range 100 60000
    help
      How long to wait for the reply before giving up. On timeout the
      platform keeps answering 0 and boot continues — an image that cannot
      reach a time source still runs, it just cannot stamp absolute time.

# =============================================================================
# Callback-level tracing (phase-8)
# =============================================================================

config NROS_TRACE_CALLBACKS
    bool "Emit callback register / start / end trace events"
    help
      Turn on the `trace-callbacks` cargo feature, so the executor emits a
      registration event per callback at init and a start/end pair around
      every dispatch. With this off the hooks are not compiled: the feature
      is absent from the cargo feature string, so the dispatch path is the
      same code it is today rather than a branch that is never taken.

      What it buys: a capture attributes time to EVERY registered callback,
      including the ones nobody thought to instrument. Thread-level tracing
      cannot do this — a callback does not run on a thread of its own, it
      runs inside an executor wake as an ordinary function call, so the
      tracer sees the carrier and not the payload.

      Where the events GO is the consumer's business, not this symbol's.
      The core calls an installed sink (`set_trace_sink`) whose signature is
      a plain `extern "C" fn(uint32_t, uint32_t)`; nothing here presumes CTF.
      On a Zephyr image that also sets CONFIG_TRACING_CTF, the sink that the
      entry path installs (`nros_zephyr_trace_marker`, in
      `nros_platform_zephyr_shims.c`) forwards to an out-of-tree `app_marker`
      CTF event; without CONFIG_TRACING_CTF that shim is empty and the events
      cost a call and a return. Enabling this alone therefore instruments the
      executor but records nothing — pair it with a tracing backend.

      Cost, stated honestly: two events per dispatch, none in steady state
      for registration. The per-event cost has NOT been measured in isolation
      on any target, so this is opt-in and defaults off.

