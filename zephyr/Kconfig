    default 2000
    help
      Maximum time to wait for the network interface to come up
      before initializing the RMW transport.

# =============================================================================
# Host-side codegen tool (cross-compile fix-up)
# =============================================================================

config NROS_CODEGEN_TOOL
    string "Path to host-built nros-codegen binary"
    default ""
    help
      Phase 140 — Zephyr builds cross-compile for the target, but
      nros-codegen runs on the build host. Build it once via a
      parallel POSIX configure:

        cmake -S <nano-ros> -B build-host -DNANO_ROS_PLATFORM=posix
        cmake --build build-host --target nros-codegen

      and point this Kconfig at the resulting binary
      (e.g. /home/user/nano-ros/build-host/<...>/nros-codegen).

      The Zephyr module's nros_generate_interfaces() picks it up
      automatically when set. Without this (and without the binary
      on PATH), configure errors out with a Hint.

# =============================================================================
# RMW resource sizing -- OVERRIDABLE defaults
# =============================================================================
#
# These used to be hard assignments in the RMW snippets' .conf fragments. A
# snippet is applied as EXTRA_CONF_FILE, which comes AFTER the board's CONF_FILE
# in Zephyr's merge order, so a snippet value BEAT the board that had to live
# with it. The Cyclone fragment asked for a 16 MiB malloc arena, a 4 MiB kernel
# heap and a 512 KiB main stack -- reasonable on native_sim, and larger than the
# entire 320 KiB SRAM of an S32K344. The board could not say otherwise from its
# own conf; the only way out was -D on the command line, which is why the
# safety-island justfile carries a column of them.
#
# `configdefault` inserts these into each symbol's DEFAULT list instead, so a
# board conf, a prj.conf or a -D now wins, and the snippet only supplies a value
# when nobody else did. Same numbers, opposite precedence.
#
# The numbers below are the historical snippet values, unchanged on purpose:
# this commit moves WHERE they are decided, not WHAT they are, so an existing
# native_sim or QEMU build resolves exactly as before.

if NROS_RMW_CYCLONEDDS

configdefault MAIN_STACK_SIZE
    default 524288

configdefault HEAP_MEM_POOL_SIZE
    default 4194304

configdefault COMMON_LIBC_MALLOC_ARENA_SIZE
    default 16777216

configdefault SYSTEM_WORKQUEUE_STACK_SIZE
    default 8192

configdefault DYNAMIC_THREAD_STACK_SIZE
    default 32768

configdefault NET_PKT_RX_COUNT
    default 64

configdefault NET_PKT_TX_COUNT
    default 64

configdefault NET_BUF_RX_COUNT
    default 128

configdefault NET_BUF_TX_COUNT
    default 128

configdefault NET_TCP_WORKQ_STACK_SIZE
    default 4096

# 32/16, not the 1024/512 this carried until 2026-08-25. Those numbers date from
# the POSIX ddsrt sync backend, where cyclone took 3 pthread mutexes per writer
# plus one per addrset and graph size became a compile-time RAM constant (issues
# 0371/0496). nros_rmw_cyclonedds.cmake now removes sync/posix/sync.c
# unconditionally and DDSRT_WITH_ZEPHYR selects the k_mutex/k_condvar types, so
# every Zephyr cyclone image embeds its locks in the entity and takes ZERO pool
# slots. The default did not follow the backend.
#
# Measured on mr_canhubk3/s32k344: the linked image has zero call sites to
# pthread_mutex_init / _lock / pthread_cond_wait, and the pools cost 20,480 +
# 6,144 = 26,624 B of __pinned_bss that --gc-sections cannot drop. Dropping to
# 32/16 took RAM 174,908 -> 149,116, i.e. 25,792 B, 7.9% of that part's SRAM.
#
# 32/16 rather than lower on purpose: it matches the zenoh line, where the pools
# ARE used, so one number covers both and there is headroom for anything in the
# POSIX surface that reaches for a mutex without cyclone asking it to.
configdefault MAX_PTHREAD_MUTEX_COUNT
    default 32

configdefault MAX_PTHREAD_COND_COUNT
    default 16

configdefault POSIX_THREAD_THREADS_MAX
    default 16

endif # NROS_RMW_CYCLONEDDS

if NROS_RMW_ZENOH

configdefault MAIN_STACK_SIZE
    default 16384

configdefault HEAP_MEM_POOL_SIZE
    default 65536

configdefault SYSTEM_WORKQUEUE_STACK_SIZE
    default 4096

configdefault NET_PKT_RX_COUNT
    default 32

configdefault NET_PKT_TX_COUNT
    default 32

configdefault NET_BUF_RX_COUNT
    default 64

configdefault NET_BUF_TX_COUNT
    default 64

configdefault NET_TCP_WORKQ_STACK_SIZE
    default 4096

configdefault MAX_PTHREAD_MUTEX_COUNT
    default 32

configdefault MAX_PTHREAD_COND_COUNT
    default 16

configdefault POSIX_THREAD_THREADS_MAX
    default 16

endif # NROS_RMW_ZENOH

endif # NROS
