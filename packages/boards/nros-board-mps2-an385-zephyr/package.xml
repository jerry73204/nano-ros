<?xml version="1.0"?>
<package format="3">
  <name>nros_board_mps2_an385_zephyr</name>
  <version>0.0.0</version>
  <description>
    Board support for `mps2-an385-zephyr` (zephyr).
  </description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <export>
    <build_type>nros_cmake</build_type>
    <!--
      Provision, NOT consumption: this package IS a board. Must equal the
      descriptor's `names`, canonical first — `check-provider-announcements`
      compares them, because two spellings of one fact drift.
    -->
    <nano_ros_provides kind="board" name="mps2-an385-zephyr"/>
  </export>
</package>
