{#-
  The param-services and lifecycle registrations that close a C setup
  function.

  Included where it belongs — the single `__nros_entry_setup`, or TIER 0 on
  the tiered path — rather than rendered by Rust and spliced in as a string.
  phase-432 W2.3: the view carries facts, so `services` is two booleans-worth
  of decision and this file is the only place that knows what C calls them.

  Emits nothing at all when neither is declared — the caller writes the lines
  around it, so a blank line here would land in generated C.
-#}
{%- if services.param_services %}
    /* Phase 269 (W1) — param-services: register the runtime get/set surface
     * (seeding: emit_declare_params, pre-construction — issue 0745). */
    {
        /* Non-fatal (issue 0745): on RMWs without service-server support
         * (e.g. cyclonedds today) registration fails — the runtime get/set RPC
         * is unavailable, but the SEEDED store above already carries the launch
         * initials, so boot proceeds. */
        (void)nros_cpp_register_parameter_services(executor);
    }
{%- endif %}
{%- if services.lifecycle_code is not none %}
    /* Phase 269 (W2) — lifecycle-services: register + autostart. */
    {
        nros_cpp_ret_t lc_ret = nros_cpp_lifecycle_autostart(executor, {{ services.lifecycle_code }}u);
        if (lc_ret != NROS_CPP_RET_OK) return (int32_t)lc_ret;
    }
{%- endif -%}
