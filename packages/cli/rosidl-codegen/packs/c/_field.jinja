{#-
  Issue 0345 — the C payload arms shared by every C emitter.

  Why: `message_c.c.jinja` implemented RFC-0033 `heap` (malloc on deserialize,
  freed by a generated `{Struct}_fini`), while `service_c.*` / `action_c.*`
  carried owned-only clones AND emitted no `_fini` at all. Since the C storage
  mode was resolved for all three (issue 0343), a heap-configured `.srv` field
  got the heap TYPE with an owned serde body — code that does not compile.

  The C ownership convention (RFC-0033): payloads ride the raw `(data, len)`
  callbacks and the USER owns the struct — they call `_deserialize` and then
  `_fini`. Services and actions are identical in that respect
  (`nros_service_callback_t` hands the callback `request_data`/`request_len`,
  never a typed struct), so heap needs no framework or ownership change — only
  these arms plus a `_fini` per payload struct.

  Macro params: `field`, `var` (struct pointer expression, e.g. `msg`), `sname`
  (struct name, used in comments and the `_fini` reference).

  Must stay byte-identical in output to what message_c.c.jinja emitted before.
-#}
{%- macro fini_field(field, var, sname) -%}
{%- if field.is_heap %}
{%- if field.is_sequence and field.element_struct_name != "" %}
    // Release each nested element's own heap fields before freeing the array.
    for (size_t i = 0; i < {{ var }}->{{ field.name }}.size; ++i) {
        {{ field.element_struct_name }}_fini(&{{ var }}->{{ field.name }}.data[i]);
    }
{%- endif %}
    nros_platform_free({{ var }}->{{ field.name }}.data);
    {{ var }}->{{ field.name }}.data = NULL;
    {{ var }}->{{ field.name }}.size = 0;
    {{ var }}->{{ field.name }}.capacity = 0;
{%- endif %}
{%- endmacro -%}

{%- macro ser_field(field, var) -%}
{%- if field.is_primitive %}
    if (nros_cdr_{{ field.cdr_write_method }}(&ptr, end, origin, {{ var }}->{{ field.name }}) < 0) return -1;
{%- elif field.is_string %}
{%- if field.is_heap %}
    if (nros_cdr_write_string(&ptr, end, origin, {{ var }}->{{ field.name }}.data ? {{ var }}->{{ field.name }}.data : "") < 0) return -1;
{%- else %}
    if (nros_cdr_write_string(&ptr, end, origin, {{ var }}->{{ field.name }}) < 0) return -1;
{%- endif %}
{%- elif field.is_array %}
    for (size_t i = 0; i < {{ field.array_size }}; ++i) {
{%- if field.is_primitive_element %}
        if (nros_cdr_{{ field.element_cdr_write_method }}(&ptr, end, origin, {{ var }}->{{ field.name }}[i]) < 0) return -1;
{%- elif field.is_string_element %}
        if (nros_cdr_write_string(&ptr, end, origin, {{ var }}->{{ field.name }}[i]) < 0) return -1;
{%- else %}
        if ({{ field.element_struct_name }}_serialize_inline(&{{ var }}->{{ field.name }}[i], &ptr, end, origin) < 0) return -1;
{%- endif %}
    }
{%- elif field.is_sequence %}
    if (nros_cdr_write_u32(&ptr, end, origin, {{ var }}->{{ field.name }}.size) < 0) return -1;
    for (size_t i = 0; i < {{ var }}->{{ field.name }}.size; ++i) {
{%- if field.is_primitive_element %}
        if (nros_cdr_{{ field.element_cdr_write_method }}(&ptr, end, origin, {{ var }}->{{ field.name }}.data[i]) < 0) return -1;
{%- elif field.is_string_element %}
        if (nros_cdr_write_string(&ptr, end, origin, {{ var }}->{{ field.name }}.data[i]) < 0) return -1;
{%- else %}
        if ({{ field.element_struct_name }}_serialize_inline(&{{ var }}->{{ field.name }}.data[i], &ptr, end, origin) < 0) return -1;
{%- endif %}
    }
{%- else %}
    if ({{ field.nested_struct_name }}_serialize_inline(&{{ var }}->{{ field.name }}, &ptr, end, origin) < 0) return -1;
{%- endif %}
{%- endmacro -%}

{%- macro deser_field(field, var, sname) -%}
{%- if field.is_primitive %}
    if (nros_cdr_{{ field.cdr_read_method }}(&ptr, end, origin, &{{ var }}->{{ field.name }}) < 0) return -1;
{%- elif field.is_string %}
{%- if field.is_heap %}
    {
        // Heap string (RFC-0033): CDR length (incl. null) is 4-byte aligned;
        // read it, then raw-copy the bytes (chars need no alignment). Freed by
        // {{ sname }}_fini.
        uint32_t slen;
        if (nros_cdr_read_u32(&ptr, end, origin, &slen) < 0) return -1;
        if ((size_t)(end - ptr) < slen) return -1;
        if (slen > 0) {
            {{ var }}->{{ field.name }}.data = nros_platform_malloc(slen);
            if ({{ var }}->{{ field.name }}.data == NULL) return -1;
            memcpy({{ var }}->{{ field.name }}.data, ptr, slen);
            {{ var }}->{{ field.name }}.data[slen - 1] = '\0'; // ensure NUL-terminated
            {{ var }}->{{ field.name }}.size = slen - 1;
            {{ var }}->{{ field.name }}.capacity = slen;
        } else {
            {{ var }}->{{ field.name }}.data = NULL;
            {{ var }}->{{ field.name }}.size = 0;
            {{ var }}->{{ field.name }}.capacity = 0;
        }
        ptr += slen;
    }
{%- else %}
    if (nros_cdr_read_string(&ptr, end, origin, {{ var }}->{{ field.name }}, sizeof({{ var }}->{{ field.name }})) < 0) return -1;
{%- endif %}
{%- elif field.is_array %}
    for (size_t i = 0; i < {{ field.array_size }}; ++i) {
{%- if field.is_primitive_element %}
        if (nros_cdr_{{ field.element_cdr_read_method }}(&ptr, end, origin, &{{ var }}->{{ field.name }}[i]) < 0) return -1;
{%- elif field.is_string_element %}
        if (nros_cdr_read_string(&ptr, end, origin, {{ var }}->{{ field.name }}[i], sizeof({{ var }}->{{ field.name }}[i])) < 0) return -1;
{%- else %}
        if ({{ field.element_struct_name }}_deserialize_inline(&{{ var }}->{{ field.name }}[i], &ptr, end, origin) < 0) return -1;
{%- endif %}
    }
{%- elif field.is_sequence %}
    {
        uint32_t len;
        if (nros_cdr_read_u32(&ptr, end, origin, &len) < 0) return -1;
{%- if field.is_heap %}
        // Heap sequence (RFC-0033): allocate exactly `len` elements; freed by
        // {{ sname }}_fini. A re-deserialize leaks the prior buffer unless
        // the caller _fini's first.
        if (len > 0) {
            // `len` is wire data: a bare `(size_t)len * sizeof` wraps on a
            // 32-bit target and under-allocates (issue 1149's class).
            size_t bytelen;
            if (nros_cdr_seq_byte_len(len, sizeof(*{{ var }}->{{ field.name }}.data), SIZE_MAX, &bytelen) < 0) return -1;
            {{ var }}->{{ field.name }}.data = nros_platform_malloc(bytelen);
            if ({{ var }}->{{ field.name }}.data == NULL) return -1;
        } else {
            {{ var }}->{{ field.name }}.data = NULL;
        }
        {{ var }}->{{ field.name }}.size = len;
        {{ var }}->{{ field.name }}.capacity = len;
        for (size_t i = 0; i < len; ++i) {
{%- if field.is_string_element %}
            if (nros_cdr_read_string(&ptr, end, origin, {{ var }}->{{ field.name }}.data[i], sizeof(*{{ var }}->{{ field.name }}.data)) < 0) {
{%- elif field.is_primitive_element %}
            if (nros_cdr_{{ field.element_cdr_read_method }}(&ptr, end, origin, &{{ var }}->{{ field.name }}.data[i]) < 0) {
{%- else %}
            if ({{ field.element_struct_name }}_deserialize_inline(&{{ var }}->{{ field.name }}.data[i], &ptr, end, origin) < 0) {
{%- endif %}
                nros_platform_free({{ var }}->{{ field.name }}.data);
                {{ var }}->{{ field.name }}.data = NULL;
                {{ var }}->{{ field.name }}.size = 0;
                {{ var }}->{{ field.name }}.capacity = 0;
                return -1;
            }
        }
    }
{%- else %}
        {{ var }}->{{ field.name }}.size = len;
        if (len > {{ field.sequence_capacity }}) return -1;
        for (size_t i = 0; i < len; ++i) {
{%- if field.is_primitive_element %}
            if (nros_cdr_{{ field.element_cdr_read_method }}(&ptr, end, origin, &{{ var }}->{{ field.name }}.data[i]) < 0) return -1;
{%- elif field.is_string_element %}
            if (nros_cdr_read_string(&ptr, end, origin, {{ var }}->{{ field.name }}.data[i], sizeof({{ var }}->{{ field.name }}.data[i])) < 0) return -1;
{%- else %}
            if ({{ field.element_struct_name }}_deserialize_inline(&{{ var }}->{{ field.name }}.data[i], &ptr, end, origin) < 0) return -1;
{%- endif %}
        }
    }
{%- endif %}
{%- else %}
    if ({{ field.nested_struct_name }}_deserialize_inline(&{{ var }}->{{ field.name }}, &ptr, end, origin) < 0) return -1;
{%- endif %}
{%- endmacro -%}

{#- Issue 0346 — C borrowed VIEW field declaration (mirrors the Rust macro). -#}
{%- macro view_field_decl(field) -%}
{%- if field.is_borrowed %}
    {{ field.borrowed_c_type }} {{ field.name }};
{%- else %}
    {{ field | c_type }} {{ field.name }}{{ field | c_array_suffix }};
{%- endif %}
{%- endmacro -%}

{#- Issue 0346 — C borrowed deserialize arm: `borrowed_read_fn` sets pointers
    into `buffer` (no malloc, no fini); other fields copy exactly as owned. -#}
{%- macro borrowed_deser_field(field, var, sname) -%}
{%- if field.is_borrowed %}
    if ({{ field.borrowed_read_fn }}(&ptr, end, origin, &{{ var }}->{{ field.name }}) < 0) return -1;
{%- else %}
{{- deser_field(field, var, sname) }}
{%- endif %}
{%- endmacro -%}

